---
---

<section class="py-xxl px-gutter max-w-container-max mx-auto border-t border-outline-variant/20 dark:border-outline/10 scroll-reveal" id="journey">
  <div class="text-center mb-xl space-y-md">
    <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface dark:text-surface font-headline-md">Experience & Education</h2>
  </div>
  <div class="relative max-w-5xl mx-auto">
    <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-coral-red/30 hidden md:block"></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16">
      <!-- Experience Column -->
      <div class="space-y-lg relative">
        <h3 class="font-headline-md text-headline-md text-primary dark:text-primary-fixed-dim font-headline-md text-center md:text-right md:pr-xl mb-lg">Experience</h3>

        <div class="relative md:pr-xl">
          <div class="absolute right-[-12px] top-6 w-6 h-6 rounded-full bg-coral-red border-4 border-surface dark:border-on-background hidden md:block z-10"></div>
          <div class="p-lg rounded-DEFAULT border border-outline-variant/30 dark:border-outline/20 surface-card bg-surface dark:bg-surface-container-lowest border-l-4 border-l-transparent timeline-card text-left md:text-right">
            <div class="flex flex-col md:flex-row-reverse items-start md:items-center gap-md mb-md">
              <div class="w-12 h-12 rounded-full bg-surface-variant dark:bg-inverse-surface flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-primary dark:text-primary-fixed-dim">work</span>
              </div>
              <div class="flex-grow">
                <div class="flex items-center md:justify-end gap-sm mb-xs flex-wrap">
                  <h4 class="font-label-bold text-label-bold text-on-surface dark:text-surface">Kupu Id</h4>
                  <span class="px-2 py-0.5 rounded-full bg-coral-red/10 text-coral-red text-[10px] font-bold uppercase tracking-wider">Current</span>
                </div>
                <p class="text-on-surface-variant dark:text-surface-variant text-sm font-label-bold">Data Annotator</p>
                <p class="text-caption text-outline dark:text-outline-variant">Feb 2026 - Present</p>
              </div>
            </div>
            <ul class="text-body-md text-on-surface-variant dark:text-surface-variant space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-coral-red flex-shrink-0"></span>
                <span>Annotated road scene datasets including traffic signs, vehicles, and traffic lights.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-coral-red flex-shrink-0"></span>
                <span>Maintained high annotation accuracy and consistency to improve Computer Vision model performance.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-coral-red flex-shrink-0"></span>
                <span>Conducted validation and quality assurance on annotated data.</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="relative md:pr-xl mt-lg">
          <div class="absolute right-[-12px] top-6 w-6 h-6 rounded-full bg-outline-variant border-4 border-surface dark:border-on-background hidden md:block z-10"></div>
          <div class="p-lg rounded-DEFAULT border border-outline-variant/30 dark:border-outline/20 surface-card bg-surface dark:bg-surface-container-lowest border-l-4 border-l-transparent timeline-card text-left md:text-right">
            <div class="flex flex-col md:flex-row-reverse items-start md:items-center gap-md mb-md">
              <div class="w-12 h-12 rounded-full bg-surface-variant dark:bg-inverse-surface flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-primary dark:text-primary-fixed-dim">work</span>
              </div>
              <div class="flex-grow">
                <div class="flex items-center md:justify-end gap-sm mb-xs flex-wrap">
                  <h4 class="font-label-bold text-label-bold text-on-surface dark:text-surface">Previous Company</h4>
                </div>
                <p class="text-on-surface-variant dark:text-surface-variant text-sm font-label-bold">Data Intern</p>
                <p class="text-caption text-outline dark:text-outline-variant">Jun 2022 - Dec 2022</p>
              </div>
            </div>
            <ul class="text-body-md text-on-surface-variant dark:text-surface-variant space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-coral-red flex-shrink-0"></span>
                <span>Assisted in data cleaning and preliminary analysis.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-coral-red flex-shrink-0"></span>
                <span>Maintained SQL databases and query optimization.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Education Column -->
      <div class="space-y-lg relative mt-16 md:mt-0">
        <h3 class="font-headline-md text-headline-md text-primary dark:text-primary-fixed-dim font-headline-md text-center md:text-left md:pl-xl mb-lg">Education</h3>

        <div class="relative md:pl-xl mt-md">
          <div class="absolute left-[-12px] top-6 w-6 h-6 rounded-full bg-coral-red border-4 border-surface dark:border-on-background hidden md:block z-10"></div>
          <div class="p-lg rounded-DEFAULT border border-outline-variant/30 dark:border-outline/20 surface-card bg-surface dark:bg-surface-container-lowest border-l-4 border-l-transparent timeline-card">
            <div class="flex flex-col md:flex-row items-start md:items-center gap-md mb-md">
              <div class="w-12 h-12 rounded-full bg-surface-variant dark:bg-inverse-surface flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-primary dark:text-primary-fixed-dim">school</span>
              </div>
              <div class="flex-grow">
                <div class="flex items-center gap-sm mb-xs flex-wrap">
                  <h4 class="font-label-bold text-label-bold text-on-surface dark:text-surface">University Name</h4>
                  <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary dark:text-primary-fixed-dim text-[10px] font-bold uppercase tracking-wider">Graduated</span>
                </div>
                <p class="text-on-surface-variant dark:text-surface-variant text-sm font-label-bold">Information Systems (Bachelor's)</p>
                <p class="text-caption text-outline dark:text-outline-variant">2018 - 2022</p>
              </div>
            </div>
            <p class="text-body-md text-on-surface-variant dark:text-surface-variant">Focus on Data Analytics and Machine Learning. Graduated with Honors.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
