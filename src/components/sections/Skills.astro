---
---

<section class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 max-w-[1200px] mx-auto scroll-reveal" id="skills">
  <div class="text-center mb-12 sm:mb-14">
    <p class="text-xs font-semibold text-primary dark:text-primary-fixed-dim uppercase tracking-[0.2em] mb-2">Tech Stack</p>
    <h2 class="text-2xl sm:text-3xl font-bold text-on-surface dark:text-surface font-headline-md">Technical Arsenal</h2>
    <p class="text-sm sm:text-base text-on-surface-variant dark:text-surface-variant mt-2">
      Tools and technologies I use to build data solutions.
    </p>
  </div>

  <!-- Category Pills -->
  <div class="flex flex-wrap justify-center gap-2 mb-10">
    <button class="skill-category-btn active" data-category="all">All</button>
    <button class="skill-category-btn" data-category="programming">Programming</button>
    <button class="skill-category-btn" data-category="data-science">Data Science</button>
    <button class="skill-category-btn" data-category="visualization">Visualization</button>
    <button class="skill-category-btn" data-category="tools">Tools</button>
  </div>

  <!-- Skills Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4" id="skillsGrid">
    <!-- Programming -->
    <div class="skill-tile" data-category="programming">
      <div class="skill-tile-icon">
        <img alt="Python" class="w-8 h-8" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" />
      </div>
      <span class="skill-tile-label">Python</span>
    </div>
    <div class="skill-tile" data-category="programming">
      <div class="skill-tile-icon">
        <img alt="MySQL" class="w-8 h-8" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" />
      </div>
      <span class="skill-tile-label">SQL</span>
    </div>

    <!-- Data Science -->
    <div class="skill-tile" data-category="data-science">
      <div class="skill-tile-icon">
        <img alt="Pandas" class="w-8 h-8" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pandas/pandas-original.svg" />
      </div>
      <span class="skill-tile-label">Pandas</span>
    </div>
    <div class="skill-tile" data-category="data-science">
      <div class="skill-tile-icon">
        <img alt="NumPy" class="w-8 h-8" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/numpy/numpy-original.svg" />
      </div>
      <span class="skill-tile-label">NumPy</span>
    </div>
    <div class="skill-tile" data-category="data-science">
      <div class="skill-tile-icon">
        <img alt="Scikit-learn" class="w-8 h-8" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/scikitlearn/scikitlearn-original.svg" />
      </div>
      <span class="skill-tile-label">Scikit-learn</span>
    </div>
    <div class="skill-tile" data-category="data-science">
      <div class="skill-tile-icon">
        <span class="material-symbols-outlined text-3xl text-secondary dark:text-secondary-fixed-dim" style="font-variation-settings: 'FILL' 1;">merge_type</span>
      </div>
      <span class="skill-tile-label">RapidFuzz</span>
    </div>

    <!-- Visualization -->
    <div class="skill-tile" data-category="visualization">
      <div class="skill-tile-icon">
        <span class="material-symbols-outlined text-3xl text-tertiary dark:text-tertiary-fixed-dim" style="font-variation-settings: 'FILL' 1;">analytics</span>
      </div>
      <span class="skill-tile-label">Tableau</span>
    </div>
    <div class="skill-tile" data-category="visualization">
      <div class="skill-tile-icon">
        <span class="material-symbols-outlined text-3xl text-tertiary dark:text-tertiary-fixed-dim" style="font-variation-settings: 'FILL' 1;">monitoring</span>
      </div>
      <span class="skill-tile-label">Power BI</span>
    </div>
    <div class="skill-tile" data-category="visualization">
      <div class="skill-tile-icon">
        <span class="material-symbols-outlined text-3xl text-tertiary dark:text-tertiary-fixed-dim" style="font-variation-settings: 'FILL' 1;">table</span>
      </div>
      <span class="skill-tile-label">Google Sheets</span>
    </div>
    <div class="skill-tile" data-category="visualization">
      <div class="skill-tile-icon">
        <span class="material-symbols-outlined text-3xl text-tertiary dark:text-tertiary-fixed-dim" style="font-variation-settings: 'FILL' 1;">grid_on</span>
      </div>
      <span class="skill-tile-label">Excel</span>
    </div>

    <!-- Tools -->
    <div class="skill-tile" data-category="tools">
      <div class="skill-tile-icon">
        <img alt="GitHub" class="w-8 h-8 tech-logo-dark-invert" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" />
      </div>
      <span class="skill-tile-label">GitHub</span>
    </div>
    <div class="skill-tile" data-category="tools">
      <div class="skill-tile-icon">
        <img alt="Jupyter" class="w-8 h-8" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jupyter/jupyter-original.svg" />
      </div>
      <span class="skill-tile-label">Jupyter</span>
    </div>
    <div class="skill-tile" data-category="tools">
      <div class="skill-tile-icon">
        <img alt="Google" class="w-8 h-8" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" />
      </div>
      <span class="skill-tile-label">Google Colab</span>
    </div>
    <div class="skill-tile" data-category="tools">
      <div class="skill-tile-icon">
        <span class="material-symbols-outlined text-3xl text-coral-red dark:text-primary-fixed-dim" style="font-variation-settings: 'FILL' 1;">database</span>
      </div>
      <span class="skill-tile-label">Databricks</span>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.skill-category-btn');
    const tiles = document.querySelectorAll('.skill-tile');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Update active button
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter tiles
        tiles.forEach(tile => {
          const tileCategory = tile.getAttribute('data-category');
          if (category === 'all' || tileCategory === category) {
            tile.classList.remove('hidden');
            tile.classList.add('visible');
          } else {
            tile.classList.add('hidden');
            tile.classList.remove('visible');
          }
        });
      });
    });
  });
</script>
