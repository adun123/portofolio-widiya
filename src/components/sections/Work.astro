---
---

<section class="py-16 sm:py-20 lg:py-24 px-4 sm:px-6 max-w-[1200px] mx-auto scroll-reveal" id="work">
  <div class="mb-12 sm:mb-16">
    <p class="text-xs font-semibold text-primary dark:text-primary-fixed-dim uppercase tracking-[0.2em] mb-2">Selected Projects</p>
    <h2 class="text-2xl sm:text-3xl font-bold text-on-surface dark:text-surface font-headline-md">Featured Work</h2>
  </div>

  <!-- Project List -->
  <div class="project-list" id="projectGrid">
    <!-- Project 1 -->
    <article class="project-item" data-project="1">
      <div class="project-meta">
        <span class="project-number">01</span>
        <span class="project-date">Jan — May 2025</span>
      </div>
      <div class="project-thumbnail">
        <img src="/images/projects/fuzzy-matching.png" alt="Automation Data Cleaning" loading="lazy" />
      </div>
      <div class="project-content">
        <div class="project-header">
          <h3 class="project-title">Automation Data Cleaning</h3>
          <span class="project-tag">Fuzzy Matching</span>
        </div>
        <p class="project-desc">
          Automated text cleaning and normalization using Python, Pandas, and NumPy. Applied fuzzy matching algorithms (RapidFuzz, FuzzyWuzzy) to detect and reconcile inconsistent or duplicate records.
        </p>
        <div class="project-tools">
          <span>Python</span>
          <span>Pandas</span>
          <span>NumPy</span>
          <span>RapidFuzz</span>
        </div>
      </div>
      <div class="project-arrow">
        <span class="material-symbols-outlined">arrow_forward</span>
      </div>
    </article>

    <!-- Project 2 -->
    <article class="project-item" data-project="2">
      <div class="project-meta">
        <span class="project-number">02</span>
        <span class="project-date">Jun — Aug 2024</span>
      </div>
      <div class="project-thumbnail">
        <img src="/images/projects/music-genre-prediction.png" alt="Prediksi Genre Musik" loading="lazy" />
      </div>
      <div class="project-content">
        <div class="project-header">
          <h3 class="project-title">Prediksi Genre Musik</h3>
          <span class="project-tag">Major/Minor</span>
        </div>
        <p class="project-desc">
          Machine learning classification to predict music genre characteristics. Analyzed key features like tempo, energy, and mode to build a reliable predictive model with accuracy evaluation.
        </p>
        <div class="project-tools">
          <span>Scikit-learn</span>
          <span>Python</span>
          <span>Classification</span>
        </div>
      </div>
      <div class="project-arrow">
        <span class="material-symbols-outlined">arrow_forward</span>
      </div>
    </article>

    <!-- Project 3 -->
    <article class="project-item" data-project="3">
      <div class="project-meta">
        <span class="project-number">03</span>
        <span class="project-date">Jun — Aug 2024</span>
      </div>
      <div class="project-thumbnail">
        <img src="/images/projects/project-3.svg" alt="E-Literasi" loading="lazy" />
      </div>
      <div class="project-content">
        <div class="project-header">
          <h3 class="project-title">E-Literasi</h3>
          <span class="project-tag">Flutter App</span>
        </div>
        <p class="project-desc">
          Led end-to-end development of a digital reading application as Project Manager. Coordinated developers and UI/UX designers, defined timelines, and oversaw feature planning.
        </p>
        <div class="project-tools">
          <span>Flutter</span>
          <span>Project Management</span>
          <span>Team Lead</span>
        </div>
      </div>
      <div class="project-arrow">
        <span class="material-symbols-outlined">arrow_forward</span>
      </div>
    </article>

    <!-- Project 4 -->
    <article class="project-item" data-project="4">
      <div class="project-meta">
        <span class="project-number">04</span>
        <span class="project-date">Apr — Oct 2023</span>
      </div>
      <div class="project-thumbnail">
        <img src="/images/projects/tracoo.png" alt="Traco" loading="lazy" />
      </div>
      <div class="project-content">
        <div class="project-header">
          <h3 class="project-title">Traco</h3>
          <span class="project-tag">PKM Funded</span>
        </div>
        <p class="project-desc">
          Smart City transportation system for Bandung. Mobile-based app developed for PKM competition — successfully received funding. Handled version control, unit testing, and UI testing.
        </p>
        <div class="project-tools">
          <span>Mobile App</span>
          <span>Git</span>
          <span>Testing</span>
        </div>
      </div>
      <div class="project-arrow">
        <span class="material-symbols-outlined">arrow_forward</span>
      </div>
    </article>

    <!-- Project 5 -->
    <article class="project-item" data-project="5">
      <div class="project-meta">
        <span class="project-number">05</span>
        <span class="project-date">Nov 2022 — Mar 2023</span>
      </div>
      <div class="project-thumbnail">
        <img src="/images/projects/pos.png" alt="POS Toko" loading="lazy" />
      </div>
      <div class="project-content">
        <div class="project-header">
          <h3 class="project-title">POS Toko</h3>
          <span class="project-tag">Python</span>
        </div>
        <p class="project-desc">
          Simple Point of Sale application for small stores. Built with modular programming practices, implemented CRUD features for product data and transaction processing.
        </p>
        <div class="project-tools">
          <span>Python</span>
          <span>CRUD</span>
          <span>Desktop App</span>
        </div>
      </div>
      <div class="project-arrow">
        <span class="material-symbols-outlined">arrow_forward</span>
      </div>
    </article>
  </div>
</section>

<!-- Project Modal -->
<div id="projectModal" class="project-modal">
  <div class="project-modal-overlay"></div>
  <div class="project-modal-content">
    <button class="project-modal-close" aria-label="Close modal">
      <span class="material-symbols-outlined">close</span>
    </button>
    <div class="project-modal-body">
      <div class="project-modal-image">
        <img id="modalImage" src="" alt="" />
      </div>
      <div class="project-modal-info">
        <span class="project-modal-tag" id="modalTag"></span>
        <h3 class="project-modal-title" id="modalTitle"></h3>
        <p class="project-modal-desc" id="modalDesc"></p>
        <div class="project-modal-tools" id="modalTools"></div>
        <div class="project-modal-meta">
          <span id="modalDate"></span>
        </div>
      </div>
    </div>
  </div>
</div>
