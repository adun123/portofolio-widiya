---
---

<section class="relative min-h-[80vh] flex flex-col justify-center items-center text-center px-gutter overflow-hidden scroll-reveal">
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <!-- Aurora Background -->
    <div class="absolute inset-0 aurora-container">
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-orb aurora-orb-4"></div>
    </div>
    <div class="absolute inset-[-100%] hero-particle-grid"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-background/60 via-transparent to-background/60 dark:from-on-background/60 dark:to-on-background/60 z-10"></div>
  </div>
  <div class="relative z-20 max-w-4xl mx-auto space-y-xl">
    <div class="space-y-lg flex flex-col items-center">
      <p class="font-label-bold text-label-bold text-primary dark:text-primary-fixed-dim uppercase tracking-widest animate-[fadeIn_1s_ease-out]">Hello! I'm Widiya Pramestika</p>
      <h1 class="font-hero text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-on-surface dark:text-surface leading-[1.1] font-bold">
        I am a<br/>
        <span class="text-primary dark:text-primary-fixed-dim rotating-text"><span class="rotating-text-inner" id="heroRotator">Data Analyst</span></span>
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant dark:text-surface-variant max-w-2xl mx-auto opacity-80 text-center">
        Welcome to My Personal Portofolio
      </p>
    </div>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-md pt-lg reveal-text reveal-delay-1" style="animation-delay: 2.4s;">
      <a class="px-lg py-md rounded-full bg-primary text-on-primary hover:bg-primary/90 btn-hover font-label-bold text-label-bold flex items-center gap-sm" href="#work">
        View My Work <span class="material-symbols-outlined text-body-md">arrow_downward</span>
      </a>
      <a class="px-lg py-md rounded-full border border-primary text-primary dark:text-primary-fixed-dim dark:border-primary-fixed-dim hover:bg-primary/5 btn-hover font-label-bold text-label-bold flex items-center gap-sm" href="#contact">
        Let's Connect <span class="material-symbols-outlined text-body-md">arrow_forward</span>
      </a>
    </div>
  </div>
</section>

<style>
  .aurora-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
  }

  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    will-change: transform;
  }

  html.dark .aurora-orb {
    opacity: 0.25;
  }

  .aurora-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #b41d25 0%, transparent 70%);
    top: -10%;
    left: -5%;
    animation: auroraFloat 20s ease-in-out infinite alternate;
  }

  .aurora-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #6d4e9f 0%, transparent 70%);
    top: 20%;
    right: -8%;
    animation: auroraFloat 25s ease-in-out infinite alternate-reverse;
  }

  .aurora-orb-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, #E84545 0%, transparent 70%);
    bottom: -5%;
    left: 30%;
    animation: auroraFloat 18s ease-in-out infinite alternate;
  }

  .aurora-orb-4 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, #008280 0%, transparent 70%);
    top: 5%;
    left: 50%;
    animation: auroraFloat 22s ease-in-out infinite alternate-reverse;
  }

  @keyframes auroraFloat {
    0% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -20px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 15px) scale(0.9);
    }
    100% {
      transform: translate(15px, -10px) scale(1.05);
    }
  }
</style>
